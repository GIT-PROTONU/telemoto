root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.urscript]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2

[*.script]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4

[*.{cpp,hpp,h,c}]
indent_style = space
indent_size = 4

[*.{yaml,yml,toml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
