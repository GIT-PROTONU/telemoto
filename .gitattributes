# Normalize line endings on commit/checkout
* text=auto

# URScript — always LF, never CRLF
*.urscript text eol=lf
*.script    text eol=lf

# Python / launch / YAML source
*.py   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.xml  text eol=lf
*.toml text eol=lf
*.cmake text eol=lf
*.md   text eol=lf

# C++
*.cpp text eol=lf
*.hpp text eol=lf
*.h   text eol=lf
*.c   text eol=lf

# Shell
*.sh text eol=lf

# Binary assets — never diff/merge
*.urcap binary
*.urp   binary
*.png   binary
*.jpg   binary
